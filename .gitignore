# === Python defaults ===
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
*.egg-info/
*.egg
*.log

# === OS/editor files ===
.DS_Store
Thumbs.db
.vscode/
.idea/

# === Jupyter auto-saves ===
.ipynb_checkpoints/
*.ipynb_checkpoints

# === Project-specific data ===
# Do not commit raw data files
data_raw/*

# Clean/intermediate data: ignore everything in data_clean, but allow shared zips if needed
data_clean/*
!data_clean/*.zip

# Backups and temporary files
backup_*/
fix_*encoding*.py
