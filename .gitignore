# === Python defaults ===
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
*.egg-info/
*.egg
*.log

# === OS files ===
.DS_Store
Thumbs.db

# === Project-specific ===
# Do not commit raw data CSVs
data_raw/*

# Clean/intermediate data: ignore everything in data_clean, but allow shared zips
data_clean/*
!data_clean/*.zip

# Ignore Jupyter auto-saves
*.ipynb_checkpoints
