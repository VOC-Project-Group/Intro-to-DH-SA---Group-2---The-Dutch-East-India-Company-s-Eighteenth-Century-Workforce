# === Python defaults ===
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
*.egg-info/
*.egg
*.log

# === OS files ===
.DS_Store
Thumbs.db

# === Project-specific ===
# Do not commit raw data CSVs
data_raw/*

# Clean/intermediate data: keep raw CSVs out; allow a shared zip artifact
data_clean/*.csv
!data_clean/*.zip

# Ignore processed outputs (regenerated by scripts)
data_clean/*

# Ignore Jupyter auto-saves
*.ipynb_checkpoints
